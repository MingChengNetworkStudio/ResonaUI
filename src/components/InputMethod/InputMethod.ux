<script>
import vibrator from "@system.vibrator";
import file from '@system.file'
import { createIME } from "./assets/engine.js";
import * as core from "./assets/ime_core.js";
const ime = createIME(core);

const DICT_PATH = "/components/InputMethod/assets/dictionary/";

const shardCache = {};

function readShard(letter) {
  return new Promise(resolve => {
    if (typeof file === 'undefined' || !file.readText) { resolve(null); return }
    try {
      file.readText({
        uri: DICT_PATH + 'p_' + letter + '.txt',
        encoding: 'UTF-8',
        success: data => {
          const txt = typeof data === 'string' ? data : (data && data.text)
          if (!txt) { resolve(null); return }
          let obj
          try { obj = JSON.parse(txt) } catch (e) { resolve(null); return }
          const rg = ime.rangeOf(letter)
          if (!rg || !obj || !obj.d) { resolve(null); return }
          resolve({ data: obj.d, len: obj.l, lo: rg[0], hi: rg[1] })
        },
        fail: () => resolve(null),
      })
    } catch (e) {
      resolve(null)
    }
  })
}

ime.attachPhraseLoader(async gid => {
  const letter = ime.letterOf(gid)
  if (!letter) return null
  if (shardCache[letter] !== undefined) return shardCache[letter]
  let rec = null
  try {
    rec = await readShard(letter)
  } catch (e) {
    rec = null
  }
  shardCache[letter] = rec
  return rec
});

const CAND_LIMIT = 30;

function deleteLast(t) {
  if (t) {
    return t.substr(0, t.length - 1);
  }
  return "";
}
export default {
  props: {
    hide: {
      default: true,
    },
    // 圆屏键盘形态：'normal' = 经典绝对定位键盘；其它任意值（如 'QWERTY'）= 横向滚动键盘
    circlemode: {
      default: "normal",
    },
    maxlength: {
      default: 5,
    },
    vibratemode: {
      default: "",
    },
    screentype: {
      default: "circle",
    },
  },
  data: {
    cval: "",
    resultList: [],
    resultList2: [],
    downFlag: "",
    lang: "cn",
    numFlag: false,
    cursorFlag: false,
    upperFlag: false,
    cvalList: [0, 1, 2, 3, 4],
    percent67: 52,
    percent66: 0,
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"],
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "!", "@", "#", "%", "“", "”", "*", "?", "/"],
        ["(", ")", "-", "_", ":", ";", "，", "。", "."],
      ],
      sign62: [
        ["2", "3", "4", "5", "6", "7", "8", "9"],
        ["!", "@", "#", "%", "“", "”", "*"],
        [")", "-", ".", ":", ";"],
      ],
      full62: [
        ["W", "E", "R", "T", "Y", "U", "I", "O"],
        ["S", "D", "F", "G", "H", "J", "K"],
        ["X", "C", "V", "B", "N"],
      ],
      cursor: [
        ["复制", "↑", "粘贴"],
        ["←", "选择", "→"],
        ["剪切", "↓", "全选"],
      ],
    },
  },
  onInit() {
    if (this.maxlength) {
      const tempCvalList = [];
      for (let i = 0; i < this.maxlength; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
    this.$watch("hide", "watchHidePropsChange");
    this.$watch("maxlength", "watchMaxLengthPropsChange");
  },
  addAllTxt(txt) {
    this.$emit("complete", { content: txt });
  },
  onRsSelect(txt) {
    this.onVibrate();
    const py = this.currentPinyin();
    const n = (txt || "").length;
    this.addAllTxt(txt);
    this.cval = n > 0 ? ime.remaining(py, n) : "";
    this.downFlag = "";
    this.resetReslutList();
  },
  onBtnClick(sign) {
    this.onVibrate();
    switch (sign) {
      case "AC":
        this.cval = "";
        this.resetReslutList();
        break;
      case "lang":
        if (this.lang === "cn") {
          this.lang = "en";
        } else {
          this.lang = "cn";
        }
        this.cval = "";
        this.resetReslutList();
        break;
      case "D":
        if (this.cval.length > 0) {
          this.cval = deleteLast(this.cval);
          this.resetReslutList();
        } else {
          this.$emit("delete", {});
        }
        break;
      case "space":
        this.addAllTxt(" ");
        break;
      case "down":
        this.downFlag = this.downFlag === "down" ? "" : "down";
        if (this.downFlag === "down") {
          this.setResultListAll();
        } else {
          this.resultList2 = [];
        }
        break;
      case "switchNum":
        this.numFlag = true;
        this.cval = "";
        this.resetReslutList();
        break;
      case "switchCn":
        this.numFlag = false;
        this.cursorFlag = false;
        break;
      case "switchCursor":
        this.cursorFlag = !this.cursorFlag;
        break;
      case "newline":
        this.addAllTxt("\n");
        break;
      case "switchUpper":
        this.upperFlag = true;
        break;
      case "switchLow":
        this.upperFlag = false;
        break;
      default:
        if (sign.length === 1) {
          this.addAllTxt(sign);
        }
        break;
    }
  },
  candWidth(word) {
    const n = (word || "").length;
    if (n <= 1) return 52;
    return 26 + 26 * n;
  },
  currentPinyin() {
    return this.cval;
  },
  async resetReslutList() {
    const cvalScroll = this.$element("cvalWaiting");
    if (cvalScroll) {
      cvalScroll.scrollTo({
        top: 0,
        left: 0,
        behavior: "smooth",
      });
    }
    const py = this.currentPinyin();
    if (!py || this.lang != "cn") {
      this.resultList = [];
      this.resultList2 = [];
      return;
    }
    const seg = ime.segment(py);
    if (seg.ids.length >= 1 && (seg.ids.length > 1 || seg.partial)) {
      await ime.ensureGroup(seg.ids[0]);
    }
    const r = ime.query(py, CAND_LIMIT);
    this.resultList = r.candidates;
    if (this.downFlag === "down") {
      this.setResultListAll();
    } else {
      this.resultList2 = [];
    }
  },
  setResultListAll() {
    this.resultList2 = [];
    let array = [];
    for (let i = 0; i < this.resultList.length; i++) {
      array.push(this.resultList[i]);
      if (array.length === parseInt(this.maxlength)) {
        this.resultList2.push(array);
        array = [];
      }
    }
    if (array.length > 0 && array.length < parseInt(this.maxlength)) {
      this.resultList2.push(array);
    }
  },
  onSelect(num) {
    this.$emit("keyDown", { content: num });
    this.onVibrate();
    if (this.lang === "cn" && !this.numFlag) {
      this.cval += num.toLowerCase();
    } else if (this.lang === "en" && !this.numFlag) {
      if (this.upperFlag) {
        this.addAllTxt(num.toUpperCase());
      } else {
        this.addAllTxt(num.toLowerCase());
      }
    } else {
      this.addAllTxt(num);
    }
    this.resetReslutList();
  },
  watchHidePropsChange(newV) {
    this.$emit("visibilityChange", { visible: newV });
  },
  watchMaxLengthPropsChange(newV) {
    if (newV) {
      const tempCvalList = [];
      for (let i = 0; i < newV; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
  },
  onVibrate() {
    if (this.vibratemode != "") {
      vibrator.vibrate({ mode: this.vibratemode });
    }
  },
  handelScroll(event) {
    let percentTemp67 = (event.scrollX / 636) * 100 + 52.8;
    this.percent67 = parseInt(percentTemp67 <= 100 ? percentTemp67 : 100);
    let percentTemp66 = (event.scrollX / 633) * 100;
    this.percent66 = parseInt(percentTemp66 <= 100 ? percentTemp66 : 100);
  },
  pushCval() {
    this.onVibrate();
    let temp = this.cval;
    this.cval = "";
    this.resetReslutList();
    this.addAllTxt(temp);
  },
  onCursorBtn(action) {
    this.onVibrate()
    switch (action) {
      case "↑":
        this.$emit("cursormove", {direction: 'up'})
        break
      case "↓":
        this.$emit("cursormove", {direction: 'down'})
        break
      case "←":
        this.$emit("cursormove", {direction: 'left'})
        break
      case "→":
        this.$emit("cursormove", {direction: 'right'})
        break
      case "选择":
        this.$emit("cursorselect", {})
        break
      case "复制":
        this.$emit("copy", {})
        break
      case "粘贴":
        this.$emit("paste", {})
        break
      case "剪切":
        this.$emit("cut", {})
        break
      case "全选":
        this.$emit("selectall", {})
        break
      default:
        break
    }
  }
};
</script>

<style>
.page {
	width:100%;
	position:absolute;
	left:0;
	bottom:0
}

/* 圆屏方角键外框（52 高） */
.sbtn {
	width:60px;
	height:52px;
	padding:7px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	border-radius:12px;
	flex-direction:row;
	align-items:center;
	justify-content:center;
	flex-shrink:0
}
/* 滚动键盘圆角键外框（60 圆） */
.tbtn {
	width:60px;
	height:60px;
	padding:9px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	border-radius:30px;
	flex-direction:row;
	align-items:center;
	justify-content:center;
	flex-shrink:0
}
/* 键内图标：填满内容区并按比例缩放，不变形 */
.kico {
	width:100%;
	height:100%;
	object-fit:contain
}

/* 圆屏62 候选词条目 */
.item {
	height:52px;
	flex:1
}
/* 候选词按钮：透明底无边框 */
.calbtn0 {
	color:#fff;
	font-size:28px;
	background-color:rgba(38,38,38,0);
	border-radius:0;
	height:52px;
	width:52px;
	text-align:center
}
/* 候选条候选：32号字、42高，透明底 */
.calbtn02 {
	color:rgb(255,255,255);
	background-color:rgba(38,38,38,0);
	border-radius:0px;
	font-size:32px;
	text-align:center;
	height:42px;
}
/* 圆屏62 字母/符号键 */
.calbtnfull {
	color:#fff;
	font-size:24px;
	font-weight:bold;
	background-color:#262626;
	border-radius:12px;
	margin-right:4px;
	height:52px;
	width:40px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06)
}
/* 圆屏62 展开候选悬浮列表 */
.list3 {
	position:absolute;
	top:38px;
	left:78px;
	width:324px;
	height:160px;
	flex-direction:column;
	background-color:#262626;
	border-radius:12px
}
.item3 {
	width:324px;
	height:52px
}
/* 横向滚动键盘圆形键 */
.calbtn67 {
	color:rgb(255,255,255);
	font-size:32px;
	font-weight:bold;
	background-color:rgb(38,38,38);
	margin-right:4px;
	width:60px;
	height:60px;
	border-radius:30px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06);
}
#keyboard67 {
	position:absolute;
	left:0px;
	top:82px;
	width:100%;
	height:170px;
}
/* 胶囊66 圆形键（右边距 3px） */
.calbtn66 {
	color:rgb(255,255,255);
	font-size:32px;
	font-weight:bold;
	background-color:rgb(38,38,38);
	margin-right:3px;
	width:60px;
	height:60px;
	border-radius:30px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06);
}
#keyboard66 {
	position:absolute;
	left:0px;
	top:82px;
	width:100%;
	height:170px;
}
/* 滚动键盘展开候选列表 */
.list67 {
	top:0px;
	width:96.4%;
	height:170px;
	border-radius:30px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	padding:0px 10px;
}
.item67 {
	height:50px;
}
/* 胶囊66 展开候选弧形面板 */
.list66 {
	position:absolute;
	left:3px;
	top:0px;
	width:186px;
	height:186px;
	border-radius:30px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	padding:10px
}
.item66 {
	height:42px;
}

/* 光标键盘功能键字号 */
.cursor-btn {
	font-size: 20px;
}
.cursor-btn-67 {
	font-size: 22px;
}
</style>
